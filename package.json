{
	"name": "@cldmv/io-kasa-api",
	"version": "0.1.0",
	"description": "Slothlet-powered API module for controlling TP-Link Kasa IoT devices on the local network.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsc -p .configs/tsconfig.build.json",
		"build:ci": "npm run typecheck && npm run build",
		"typecheck": "tsc -p .configs/tsconfig.base.json",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mts",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"discover": "node --no-warnings --experimental-strip-types tools/discover.mts",
		"prepublishOnly": "npm run build",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\""
	},
	"keywords": [
		"kasa",
		"tp-link",
		"tplink",
		"smarthome",
		"smart-home",
		"home-automation",
		"iot",
		"smart-plug",
		"smart-bulb",
		"smart-switch",
		"dimmer",
		"hs100",
		"hs110",
		"hs300",
		"slothlet",
		"local-network",
		"nodejs",
		"esm",
		"typescript"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"license": "Apache-2.0",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/io-kasa-api.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/io-kasa-api/issues"
	},
	"homepage": "https://github.com/CLDMV/io-kasa-api#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@cldmv/slothlet": "^3.20.0",
		"esbuild": "^0.28.0"
	},
	"devDependencies": {
		"@cldmv/jsonv": "^1.0.9",
		"@cldmv/prettier-plugin-jsonv": "^1.0.6",
		"@cldmv/slothlet-types": "^3.20.0",
		"@cldmv/vitest-runner": "^1.4.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.19.19",
		"@vitest/coverage-v8": "^5.0.2",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.2"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"sideEffects": false
}
