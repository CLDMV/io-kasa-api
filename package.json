{
	"name": "@cldmv/io-kasa-api",
	"version": "0.1.0",
	"description": "Slothlet-powered API module for controlling TP-Link Kasa IoT devices on the local network.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsc -p .configs/tsconfig.build.json",
		"typecheck": "tsc -p .configs/tsconfig.base.json",
		"test": "vitest run --config .configs/vitest.config.mts",
		"test:watch": "vitest --config .configs/vitest.config.mts",
		"discover": "node --no-warnings --experimental-strip-types tools/discover.mts",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"kasa",
		"tp-link",
		"tplink",
		"smarthome",
		"smart-home",
		"home-automation",
		"iot",
		"smart-plug",
		"smart-bulb",
		"smart-switch",
		"dimmer",
		"hs100",
		"hs110",
		"hs300",
		"slothlet",
		"local-network",
		"nodejs",
		"esm",
		"typescript"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"license": "Apache-2.0",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/io-kasa-api.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/io-kasa-api/issues"
	},
	"homepage": "https://github.com/CLDMV/io-kasa-api#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@cldmv/slothlet": "^3.15.2",
		"esbuild": "^0.28.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"typescript": "^6.0.3",
		"vitest": "^2.1.8"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"sideEffects": false
}
