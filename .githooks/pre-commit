#!/bin/sh
#
# CLDMV fleet pre-commit hook.
#
# Runs the repo's lint + format checks before a commit, then any repo-local
# `precommit:local` checks. Each uses `npm run <script> --if-present`, so this
# is a graceful no-op in a repo that hasn't defined the script yet — the same
# hook is safe to drop into any repo.
#
# Installed into .git/hooks/pre-commit by examples/git-hooks/install.mjs, wired
# to the package.json `prepare` script (fires on `npm install`). It installs
# into .git/hooks (NOT via core.hooksPath) on purpose: a global core.hooksPath
# dispatcher chains to .git/hooks/<name>, so writing here keeps global policy
# (e.g. no-coauthor / no-unsigned-push) intact while adding the lint/format gate.
#
# Project-specific extra checks: define a `precommit:local` npm script and it
# runs last, after lint/format — no need to fork this shared hook.
#
# On failure:
#   - formatting: run `npm run format` to auto-fix, then re-stage.
#   - lint:       run `npm run lint` to see the problems.
set -e

npm run lint --if-present
npm run format:check --if-present
npm run precommit:local --if-present
