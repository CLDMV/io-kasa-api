{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": false,
		"rewriteRelativeImportExtensions": true,
		"outDir": "../dist",
		"rootDir": "../src",
		"declarationMap": false,
		"sourceMap": false
	},
	"include": ["../src/**/*.mts"],
	"exclude": ["../node_modules", "../dist", "../.slothlet-cache", "../tools", "../tests"]
}
